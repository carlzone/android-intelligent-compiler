aic_version 0.1
app "AIC Counter" package "dev.aic.generated.counter" {
  activity MainActivity {
    state count: i32 = 0
    on_create {
      let root = android.linear_layout(orientation: vertical)
      let output = android.text_view(text: "Count: " + string(count))
      let increment = android.button(text: "Increment")
      let decrement = android.button(text: "Decrement")
      let reset = android.button(text: "Reset")
      android.set_layout(view: root, width: match_parent, height: match_parent, weight: 0)
      android.set_layout(view: output, width: match_parent, height: wrap_content, weight: 0)
      android.set_text_color(view: output, color: "#202124")
      android.set_background_color(view: root, color: "#FAFAFA")
      android.add_view(parent: root, child: output)
      android.add_view(parent: root, child: increment)
      android.add_view(parent: root, child: decrement)
      android.add_view(parent: root, child: reset)
      android.set_content_view(root)
    }
    on_click(increment) {
      count = count + 1
      android.set_text(view: output, text: "Count: " + string(count))
    }
    on_click(decrement) {
      count = count - 1
      android.set_text(view: output, text: "Count: " + string(count))
    }
    on_click(reset) {
      count = 0
      android.set_text(view: output, text: "Count: " + string(count))
    }
  }
}
