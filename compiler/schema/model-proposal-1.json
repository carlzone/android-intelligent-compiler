{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aic.dev/schema/model-proposal-1.json",
  "title": "AIC model proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "source", "summary", "touched_areas"],
  "properties": {
    "schema_version": { "const": "aic.model-proposal/1" },
    "operation": { "enum": ["create", "patch"] },
    "source": { "type": "string", "minLength": 1, "maxLength": 1048576 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "touched_areas": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": { "enum": ["metadata", "state", "functions", "capabilities", "persistence", "ui", "events"] } }
  }
}
