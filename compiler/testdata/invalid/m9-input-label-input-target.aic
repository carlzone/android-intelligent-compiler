aic_version 0.2 app "Bad input" package "dev.aic.badinput" { activity MainActivity { on_create { let root = android.linear_layout(orientation: vertical) let label = android.text_view(text: "Name") let input = android.button(text: "Name") android.set_input_label(label: label, input: input) android.add_view(parent: root, child: label) android.add_view(parent: root, child: input) android.set_content_view(root) } } }
