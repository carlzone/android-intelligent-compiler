aic_version 0.2 app "Duplicate label" package "dev.aic.duplicatelabel" { activity MainActivity { on_create { let root = android.linear_layout(orientation: vertical) let label = android.text_view(text: "Name") let first = android.text_input(hint: "First", input_type: text) let second = android.text_input(hint: "Second", input_type: text) android.set_input_label(label: label, input: first) android.set_input_label(label: label, input: second) android.add_view(parent: root, child: label) android.add_view(parent: root, child: first) android.add_view(parent: root, child: second) android.set_content_view(root) } } }
