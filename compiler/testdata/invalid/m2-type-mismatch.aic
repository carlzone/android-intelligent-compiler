aic_version 0.1
app "Invalid Type" package "dev.aic.invalid.types" {
  fn broken(value: bool) -> i32 {
    return value
  }
  activity MainActivity {
    on_create {
      let root = android.linear_layout(orientation: vertical)
      let message = android.text_view(text: "invalid")
      android.add_view(parent: root, child: message)
      android.set_content_view(root)
    }
  }
}
