aic_version 0.2 app "Bad label" package "dev.aic.badlabel" { activity MainActivity { on_create { let root = android.linear_layout(orientation: vertical) let label = android.button(text: "Name") let input = android.text_input(hint: "Name", input_type: text) android.set_input_label(label: label, input: input) android.add_view(parent: root, child: label) android.add_view(parent: root, child: input) android.set_content_view(root) } } }
